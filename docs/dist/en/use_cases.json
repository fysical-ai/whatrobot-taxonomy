          "key": "slope",
          "name": "Steepest slope",
          "type": "number",
          "unit": "deg",
          "description": "In degrees. 20 % is about 11°, 35 % about 19°, 45 % about 24°.",
          "default": null
        }
      ],
      "body_plans": [
        {
          "category_id": "rb-4-1",
          "name": "Wheeled robot",
          "full_name": "Robot > Ground robot > Wheeled robot",
          "note": "Almost every robot mower: a wheeled, battery-driven mower that returns to its charger."
        },
        {
          "category_id": "rb-4-2",
          "name": "Tracked robot",
          "full_name": "Robot > Ground robot > Tracked robot",
          "note": "Tracked mowers, for steep or rough ground."
        }
      ],
      "related_applications": [],
      "environment": [
        "env-outdoor-all-weather"
