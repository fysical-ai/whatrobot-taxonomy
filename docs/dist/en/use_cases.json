        },
        {
          "attribute": "ip_rating",
          "op": "ip_liquids>=",
          "value": 4,
          "level": "soft",
          "rationale": "Rain. A second digit of 4 means protection against water splashed from any direction.",
          "source": "IEC 60529",
          "profile": "env-outdoor-all-weather"
        },
        {
          "attribute": "ip_rating",
          "op": "ip_solids>=",
          "value": 5,
          "level": "soft",
          "rationale": "Dust. A first digit of 5 means dust-protected.",
          "source": "IEC 60529",
          "profile": "env-outdoor-all-weather"
        },
        {
          "attribute": "autonomy",
          "op": "in",
          "value": [
            "semi-autonomous",
            "autonomous"
          ],
          "level": "hard",
