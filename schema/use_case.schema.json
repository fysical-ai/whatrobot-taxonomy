{
  "$defs": {
    "BodyPlan": {
      "additionalProperties": false,
      "description": "A robot category that can do the job, with a one-line note on when it is the right kind.",
      "properties": {
        "category": {
          "pattern": "^(rb|cp)(-[1-9]\\d*)*$",
          "title": "Category",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "category",
        "note"
      ],
      "title": "BodyPlan",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "One test of one attribute. `value` is a literal; `param` names a use-case parameter whose current value is\nused instead (the test is skipped while that parameter is not set). Exactly one of the two is given.\n\nOperators: `has` (the attribute's value, or one of its values, is `value` or one of `value`), `in` (the same test,\nwritten for single-select attributes), `eq`, `>=`, `<=` (numbers, compared on the attribute's default measurement\nbasis only), `ip_solids>=` / `ip_liquids>=` (first / second digit of an IEC 60529 code in `ip_rating`).",
      "properties": {
        "attribute": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Attribute",
          "type": "string"
        },
        "op": {
          "enum": [
            "has",
            "in",
            "eq",
            ">=",
            "<=",
            "ip_solids>=",
            "ip_liquids>="
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "param": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Param"
        }
      },
      "required": [
        "attribute",
        "op"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "description": "Something the reader sets (a load, an area, indoor or outdoor). `default: null` means \"not set\": requirements\nbound to the parameter are skipped until the reader gives a value.",
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "number",
            "enum",
            "bool"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "key",
        "name",
        "type"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "A condition a robot must (`hard`) or should (`soft`) meet for the use case. Hard is reserved for physics,\ngeometry, law, a cited standard or the definition of the use case itself; a failed hard requirement excludes the\nrobot. A soft requirement never excludes: it is shown as something to check. `when` limits the requirement to\nparameter settings (all listed parameters must have the listed value).",
      "properties": {
        "attribute": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Attribute",
          "type": "string"
        },
        "op": {
          "enum": [
            "has",
            "in",
            "eq",
            ">=",
            "<=",
            "ip_solids>=",
            "ip_liquids>="
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "param": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Param"
        },
        "level": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Level",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "when": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "attribute",
        "op",
        "level",
        "rationale"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "Slot": {
      "additionalProperties": false,
      "description": "A role the use case needs filled by a component (or by the robot itself): which component category, and\nwhich of its attributes decide.",
      "properties": {
        "role": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Role",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "need": {
          "enum": [
            "required",
            "recommended",
            "optional"
          ],
          "title": "Need",
          "type": "string"
        },
        "category": {
          "pattern": "^(rb|cp)(-[1-9]\\d*)*$",
          "title": "Category",
          "type": "string"
        },
        "where": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Where",
          "type": "array"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name",
        "need",
        "category",
        "note"
      ],
      "title": "Slot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A job, written as requirements against the taxonomy's attributes. Which robots suit it is computed from\nproduct data by whoever holds a catalogue; no product is tagged with a use case.",
  "properties": {
    "id": {
      "description": "Permanent id; numbers are never reused",
      "pattern": "^uc-[1-9]\\d*$",
      "title": "Id",
      "type": "string"
    },
    "handle": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Handle",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "application": {
      "description": "The application value this use case sits under, e.g. application__palletizing",
      "title": "Application",
      "type": "string"
    },
    "aliases": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "solution_type": {
      "description": "turnkey: the robot is the whole solution; platform: robot + payload + software; cell: robot + tooling + safety + integration",
      "enum": [
        "turnkey",
        "platform",
        "cell"
      ],
      "title": "Solution Type",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "what_decides": {
      "description": "What decides the choice, in plain words",
      "minLength": 1,
      "title": "What Decides",
      "type": "string"
    },
    "parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Parameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "body_plans": {
      "items": {
        "$ref": "#/$defs/BodyPlan"
      },
      "minItems": 1,
      "title": "Body Plans",
      "type": "array"
    },
    "related_applications": {
      "default": [],
      "description": "Applications whose robots are plausible platforms for this job although not marketed for it",
      "items": {
        "type": "string"
      },
      "title": "Related Applications",
      "type": "array"
    },
    "environment": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Environment",
      "type": "array"
    },
    "requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "slots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Slot"
      },
      "title": "Slots",
      "type": "array"
    }
  },
  "required": [
    "id",
    "handle",
    "name",
    "application",
    "solution_type",
    "description",
    "what_decides",
    "body_plans"
  ],
  "title": "UseCase",
  "type": "object"
}
